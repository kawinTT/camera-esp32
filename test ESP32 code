    def __init__(self):
        super().__init__()
        self.setWindowTitle("Tooth Color & Camera Display")
        self.setGeometry(100, 100, 800, 400)
        
        # ตั้งค่า UI
        layout = QVBoxLayout()
        
        # ส่วนแสดงผลค่าสีที่พบและรหัส Vita
        self.tooth_label = QLabel("Tooth Color")
        self.tooth_label.setStyleSheet("background-color: black; color: white; font-size: 20px")
        self.tooth_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.tooth_label)
        
        # ส่วนแสดงผลกล้อง ESP32-CAM
        self.camera_label = QLabel("ESP32-CAM")
        self.camera_label.setAlignment(Qt.AlignmentFlag.AlignCenter)
        layout.addWidget(self.camera_label)
        
        self.setLayout(layout)
        
        # ตั้งค่า Timer
        self.timer = QTimer(self)
        self.timer.timeout.connect(self.update_display)
        self.timer.start(100)  # อัปเดตทุก 100 มิลลิวินาที
    
    def update_display(self):
        # ค่าสีที่พบ (จำลองค่า)
        detected_color = (245, 245, 220)  # เปลี่ยนค่านี้เป็นค่าสีที่พบจากการตรวจสอบจริง
        closest_vita_code = find_closest_vita_color(detected_color)
