import sys
import numpy as np
import requests
from PyQt6.QtWidgets import QApplication, QLabel, QWidget, QVBoxLayout, QHBoxLayout
from PyQt6.QtCore import Qt, QTimer

# URL ของ ESP32-CAM (เปลี่ยนเป็น IP จริงของอุปกรณ์)
ESP32CAM_URL = "http://172.20.10.5"

# ฟังก์ชันแปลงค่าสีฟัน Vita เป็นโค้ด RGB
def vita_to_rgb():
    return {
        'A1': (245, 245, 220), 'A2': (255, 239, 219), 'A3': (255, 215, 180), 'A4': (237, 204, 143),
        'B1': (255, 250, 240), 'B2': (255, 239, 199), 'B3': (252, 220, 177), 'B4': (222, 202, 159),
        'C1': (234, 220, 204), 'C2': (235, 215, 186), 'C3': (231, 196, 159), 'C4': (196, 189, 142),
        'D2': (249, 214, 183), 'D3': (246, 206, 184), 'D4': (203, 185, 158)
    }

# ฟังก์ชันหา Vita รหัสที่ใกล้เคียงที่สุด
def find_closest_vita_color(color):
    vita_rgb = vita_to_rgb()
    min_diff = float('inf')
    closest_vita_code = None
    for vita_code, vita_color in vita_rgb.items():
        diff = np.linalg.norm(np.array(color) - np.array(vita_color))
        if diff < min_diff:
            min_diff = diff
            closest_vita_code = vita_code
    return closest_vita_code

